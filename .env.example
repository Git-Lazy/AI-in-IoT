# Copy to .env and adjust. Never commit .env.

# --- Backend ---
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# --- Database ---
DATABASE_URL=sqlite:///./data/homeai.db

# --- MQTT broker ---
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=homeai-backend
MQTT_BASE_TOPIC=homeai

# --- Camera ---
# 0 = default webcam, or an RTSP URL, or a path to a video file for offline testing
CAMERA_SOURCE=0
CAMERA_FPS=10
VISION_ENABLED=true

# --- Models ---
# Detector: stub | motion | yolo.  Recognizer: stub | facenet
DETECTOR_BACKEND=yolo
RECOGNIZER_BACKEND=facenet
YOLO_MODEL_PATH=models/yolo11n.pt
DETECTION_CONFIDENCE=0.5

# --- Face recognition precision (see README "Face recognition tuning") ---
FACE_DETECTOR=mtcnn
FACE_MATCH_THRESHOLD=0.45
FACE_MATCH_MARGIN=0.08
FACE_MIN_CONFIDENCE=0.95
FACE_MIN_SIZE=60
FACE_MIN_SHARPNESS=25
FACE_VOTES_REQUIRED=3
FACE_VOTE_WINDOW=5

# --- Cameras ---
# Several cameras: name:Room:source, comma-separated. Empty = one camera on CAMERA_SOURCE.
# CAMERAS=front_door:Entry:0,garage:Garage:1
CAMERAS=

# --- Admin ---
ADMIN_FACE_VERIFY=true
ADMIN_SESSION_HOURS=8
