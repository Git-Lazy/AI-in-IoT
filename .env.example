# Copy to .env and adjust. Never commit .env.

# --- Backend ---
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# --- Database ---
DATABASE_URL=sqlite:///./data/homeai.db

# --- MQTT broker ---
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=homeai-backend
MQTT_BASE_TOPIC=homeai

# --- Camera ---
# 0 = default webcam, or an RTSP URL, or a path to a video file for offline testing
CAMERA_SOURCE=0
CAMERA_FPS=10
VISION_ENABLED=true

# --- Models ---
# "stub" until Week 3; then "yolo" / "facenet"
DETECTOR_BACKEND=stub
RECOGNIZER_BACKEND=stub
YOLO_MODEL_PATH=models/yolo11n.pt
DETECTION_CONFIDENCE=0.5
FACE_MATCH_THRESHOLD=0.6
